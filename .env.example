# x-brain — copy to .env and fill. Never commit .env.
# All values also work as environment variables.

# --- REQUIRED: target account ---------------------------------------------
# Numeric X user id (not the @handle). Find via:
#   https://tweeterid.com/  or  curl the UserByScreenName GraphQL op.
X_USER_ID=1234567890123456789

# Browser session cookies (DevTools → Application → Cookies → x.com)
X_AUTH_TOKEN=your_auth_token_here
X_CT0=your_ct0_here

# --- OPTIONAL: brain dir ---------------------------------------------------
# Where state.sqlite / cache / vault live. Default: ~/.xbrain  (or ./data)
XBRAIN_DIR=./data

# --- OPTIONAL: model catalog -----------------------------------------------
# JSON with routing_tiers + ranking_order. Default: ./config/models.json
# XBRAIN_CATALOG=./config/models.json

# --- OPTIONAL: external routing judges (one external call per flagged row) -
# If set, the router can escalate ambiguous/nsfw/low-confidence rows.
# Free tiers work: InferX (https://inferx.app) + OpenRouter (https://openrouter.ai)
# Leave empty to run 100% local.
# INFERX_API_KEY=ix-...
# OPENROUTER_API_KEY=sk-or-...

# --- OPTIONAL: local runtime -----------------------------------------------
# Ollama host. Default http://127.0.0.1:11434
# OLLAMA_HOST=http://127.0.0.1:11434

# --- OPTIONAL: LiteLLM proxy (alternative to direct Ollama) ----------------
# LITELLM_BASE=http://127.0.0.1:4000
# LITELLM_KEY=sk-local-xbrain
